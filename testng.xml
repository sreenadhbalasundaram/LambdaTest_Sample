<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LambdaTest Web and Android">
    <test name="Chrome Windows 11 - web features">
        <classes>
            <class name="com.lambdatest.LambdaTestWebDemo" />
        </classes>
    </test>
    <test name="Pixel 7 - Android app">
        <parameter name="version" value="13" />
        <parameter name="platform" value="Android" />
        <parameter name="device" value="Pixel 7" />
        <classes>
            <class name="com.lambdaTestApp.android.AndroidApp" />
        </classes>
    </test>
    <test name="QA App command log replay">
        <parameter name="device" value="Galaxy.*" />
        <parameter name="version" value="15" />
        <classes>
            <class name="com.lambdaTestApp.android.QAAppCommandLogTest" />
        </classes>
    </test>
</suite>
